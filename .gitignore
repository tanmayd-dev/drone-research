# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
env/
venv/
ENV/
build/
dist/
node_modules/
*.egg-info/
.eggs/

# IDE and editor-specific files
.vscode/
.idea/
*.swp
*.swo
*.tsbuildinfo

# Python cache and logs
*.log

# Data files - large CSVs and generated results
*.csv
*results*.csv

# Un-ignore project config JSONs
!package*.json
!tsconfig*.json
!web/**/*.json

# Neural network model weights
*.pth
*.pt
*.onnx

# Academic manuscripts, TeX sources and PDFs
*.tex
*.pdf

# Simulation output directories (if generated)
external_mode/simulations/
independent_mode/simulations/

# Ignore system files
.DS_Store
Thumbs.db
